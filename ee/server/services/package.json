{
	"name": "rocketchat-authorization",
	"version": "1.0.0",
	"description": "Rocket.Chat Authorization service",
	"main": "index.js",
	"scripts": {
		"dev": "pm2 start ecosystem.config.js",
		"pm2": "pm2",
		"start:account": "ts-node --files ./account/service.ts",
		"start:authorization": "ts-node --files ./authorization/service.ts",
		"start:ddp-streamer": "ts-node --files ./ddp-streamer/service.ts",
		"start:presence": "ts-node --files ./presence/service.ts",
		"start:stream-hub": "ts-node --files ./stream-hub/service.ts",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"build": "tsc",
		"build-containers": "npm run build && docker-compose build && rm -rf ./dist",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"keywords": [
		"rocketchat"
	],
	"author": "Rocket.Chat",
	"license": "MIT",
	"dependencies": {
		"@rocket.chat/emitter": "^0.31.1",
		"@rocket.chat/string-helpers": "^0.31.9",
		"ajv": "^8.11.0",
		"bcrypt": "^5.0.1",
		"body-parser": "^1.20.0",
		"colorette": "^2.0.16",
		"cookie": "^0.5.0",
		"cookie-parser": "^1.4.6",
		"ejson": "^2.2.2",
		"eventemitter3": "^4.0.7",
		"express": "^4.17.3",
		"jaeger-client": "^3.19.0",
		"mem": "^9.0.2",
		"moleculer": "^0.14.19",
		"mongodb": "^4.3.0",
		"nats": "^2.6.1",
		"pino": "^7.8.1",
		"sodium-native": "^3.3.0",
		"sodium-plus": "^0.9.0",
		"underscore.string": "^3.3.6",
		"uuid": "^8.3.2",
		"ws": "^8.5.0"
	},
	"devDependencies": {
		"@types/cookie": "^0.5.0",
		"@types/cookie-parser": "^1.4.2",
		"@types/ejson": "^2.2.0",
		"@types/express": "^4.17.13",
		"@types/mongodb": "^4.0.7",
		"@types/node": "^17.0.21",
		"@types/ws": "^8.2.1",
		"pino-pretty": "^7.2.0",
		"pm2": "^5.1.2",
		"ts-node": "^10.4.0",
		"typescript": "^4.6.2"
	},
	"volta": {
		"node": "12.22.1",
		"npm": "6.14.12"
	}
}
